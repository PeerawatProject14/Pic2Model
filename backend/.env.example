# Copy to .env and edit. All vars are optional; defaults run the mock pipeline.

# Generator: mock | triposr
PIC2MODEL_GENERATOR_BACKEND=mock

# Background removal: mock | rembg
PIC2MODEL_BG_BACKEND=mock

# Segmenter (auto-suggest only): manual | sam2
PIC2MODEL_SEGMENTER_BACKEND=manual

# torch device hint: auto | cuda | cpu
PIC2MODEL_DEVICE=auto

# WebGL-friendly decimation target (total faces)
PIC2MODEL_DEFAULT_TARGET_FACES=30000
